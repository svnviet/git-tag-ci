# Copy to .env and edit. Use forward slashes in paths (C:/builds/repo) or leave values unquoted.
# Repo to watch (URL or local path). Cloned into WORK_DIR if it does not exist yet.
REPO_URL=https://github.com/owner/repo.git
WORK_DIR=C:/builds/repo
# Build script (path relative to the repo, or absolute); runs with cwd = WORK_DIR, tag already checked out
BUILD_SCRIPT=build.bat
POLL_INTERVAL=60
# First run: false = mark existing tags as "skipped" and only build tags that appear later
BUILD_EXISTING=false
GIT_BIN=git
# Database. Option A: one URL (SQLite by default)
DB_URL=sqlite:///./tags.db
# Option B: PostgreSQL by parts (used when DB_URL is empty/removed and DB_HOST is set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=git_tag_ci
# DB_USER=postgres
# DB_PASSWORD=secret
# Option A for PostgreSQL: DB_URL=postgresql+psycopg://user:password@localhost:5432/git_tag_ci
LOG_DIR=./logs
BUILD_TIMEOUT=3600
# Only tags starting with this prefix are built (several prefixes: comma separated)
TAG_PREFIXES=release-
# "release-1.2.3-prod" -> params 1.2.3 prod
TAG_PARAM_SEP=-
# Script arguments: {tag} {prefix} {params} {output} {notes} {prev}
BUILD_ARGS={tag} {output} {notes}
OUTPUT_DIR=./output
